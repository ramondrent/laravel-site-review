{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ramondrent/laravel-site-review",
    "description": "Shared-password in-page commenting, live copy editing, changelog, presence, and optional multiplayer cursors for Laravel websites.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "review",
        "feedback",
        "comments",
        "inline-editing",
        "copywriting",
        "reverb"
    ],
    "authors": [
        {
            "name": "Ramon Drent",
            "email": "ramondrent@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "suggest": {
        "laravel/reverb": "Required for live multiplayer reviewer cursors (^1.0)."
    },
    "autoload": {
        "psr-4": {
            "RamonDrent\\SiteReview\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RamonDrent\\SiteReview\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RamonDrent\\SiteReview\\SiteReviewServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
